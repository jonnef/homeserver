# Heimserver – erzeugt von install.sh aus https://github.com/jonnef/homeserver
# Änderungen bitte dort vornehmen: install.sh überschreibt diese Datei (mit Backup).
#
# Erreichbar im Heimnetz über http://<Pi-IP> und im Tailnet über `tailscale serve`
# (TLS endet dort, weitergeleitet an diesen Port).

:80 {
	encode gzip

	# ---------- Apps: nur mit Anmeldung (Startseite und Vorschau bleiben öffentlich) ----------
	# Caddy fragt vor jeder App-Anfrage den Anmeldedienst. Ohne gültige Sitzung leitet er
	# Seitenaufrufe zur Anmeldung auf der Startseite um und beantwortet API-Aufrufe mit 401.
	@apps path /budget /budget/* /api/* /vorlesungen /vorlesungen/* /assets/* /manifest.webmanifest /apple-touch-icon.png /icon-192.png /icon-512.png /icon-maskable-512.png
	forward_auth @apps 127.0.0.1:8002 {
		uri /auth/check
	}

	# Anmeldedienst (Login, Logout, Status) für die Startseite
	handle /auth/* {
		reverse_proxy 127.0.0.1:8002
	}

	# ---------- Startseite ----------
	handle / {
		root * /opt/homeserver/start
		file_server
	}
	handle /start/* {
		root * /opt/homeserver
		file_server
	}
	# Ersetzt den früheren Service Worker des Budgetbuchs (Scope "/") durch einen Aufräum-Worker
	handle /sw.js {
		root * /opt/homeserver/start
		rewrite * /sw-reset.js
		file_server
	}

	# ---------- Vorschau mit Beispieldaten: öffentlich, ohne echte Daten ----------
	redir /vorschau/budget /vorschau/budget/
	handle_path /vorschau/budget/* {
		# Eigener Build, der nie mit der API spricht (Beispieldaten im Browser)
		root * /opt/budget-book/frontend-demo
		try_files {path} /index.html
		file_server
	}
	redir /vorschau/vorlesungen /vorschau/vorlesungen/
	handle_path /vorschau/vorlesungen/* {
		# Schreibgeschützte zweite Instanz mit eigener Beispiel-Datenbank
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-Prefix /vorschau/vorlesungen
		}
	}

	# ---------- Budgetbuch ----------
	redir /budget /budget/
	handle_path /budget/* {
		root * /opt/budget-book/frontend
		try_files {path} /index.html
		file_server
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	# Übergang: Frontend-Builds von vor dem Umzug laden ihre Dateien noch ab /
	@budget_legacy path /assets/* /manifest.webmanifest /apple-touch-icon.png /icon-192.png /icon-512.png /icon-maskable-512.png
	handle @budget_legacy {
		root * /opt/budget-book/frontend
		file_server
	}

	# ---------- Vorlesungen ----------
	redir /vorlesungen /vorlesungen/
	handle_path /vorlesungen/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Prefix /vorlesungen
		}
	}

	# Alles andere: zur Startseite
	handle {
		redir * / 302
	}
}
